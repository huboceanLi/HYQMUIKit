 NSNotificationName const QMUIAppSizeWillChangeNotification = @"QMUIAppSizeWillChangeNotification";
 NSString *const QMUIPrecedingAppSizeUserInfoKey = @"QMUIPrecedingAppSizeUserInfoKey";
 NSString *const QMUIFollowingAppSizeUserInfoKey = @"QMUIFollowingAppSizeUserInfoKey";
+
+/// 仅横跨内容中线且位于页面下半部的横向 TabBar 产生底部占位，侧栏交由 UIKit 布局。
+/// 两个矩形必须位于同一坐标系；使用原始栏矩形判断方向，避免裁剪后误判。
+static BOOL QMUIIsHorizontalBottomTabBar(CGRect viewFrame, CGRect barFrame) {
+    return CGRectIsValidated(viewFrame)
+        && CGRectIsValidated(barFrame)
+        && CGRectGetWidth(barFrame) > CGRectGetHeight(barFrame)
+        && CGRectIntersectsRect(viewFrame, barFrame)
+        && CGRectGetMinX(barFrame) <= CGRectGetMidX(viewFrame)
+        && CGRectGetMaxX(barFrame) >= CGRectGetMidX(viewFrame)
+        && CGRectGetMidY(barFrame) >= CGRectGetMidY(viewFrame);
+}
 
